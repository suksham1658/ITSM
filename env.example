# Environment template — Enterprise ITSM Portal
# Copy to a file that is NEVER committed (e.g. /etc/itsm/itsm.env) and fill from your secret store.
# Do not put real passwords, LDAP binds, or connection strings in Git or in the source zip.

# --- Runtime ---
JAVA_HOME=/usr/lib/jvm/java-8-openjdk
# uat | prod   (never use h2 on a shared server)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# --- SQL Server (required for uat/prod) ---
# encrypt=true; for lab-only self-signed SQL TLS you may add trustServerCertificate=true
DB_URL=jdbc:sqlserver://sql.example.in:1433;databaseName=ItsmPortal;encrypt=true
DB_USERNAME=itsm_app_user
DB_PASSWORD=
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=2

# --- LDAP / Active Directory (required for login) ---
LDAP_URL=ldaps://dc.example.in:636
LDAP_BASE_DN=DC=example,DC=in
LDAP_BIND_DN=CN=itsm-bind,OU=Service Accounts,DC=example,DC=in
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={0})
LDAP_USER_DN_PATTERN=
LDAP_EMPLOYEE_ID_ATTRIBUTE=employeeID
LDAP_MANAGER_ATTRIBUTE=manager

# --- Session (idle + absolute). Cookie Secure must be true behind HTTPS. ---
SESSION_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_COOKIE_SECURE=true

# --- Attachments (create the directory; app process must own it) ---
FILE_STORAGE_TYPE=filesystem
FILE_STORAGE_ROOT=/var/itsm/files

# --- SMTP (optional; outbound mail is not wired in this slice) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# --- H2 preview only. Leave empty on uat/prod. Never set this in production. ---
H2_PREVIEW_PASSWORD=
